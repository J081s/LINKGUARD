# Copy this file to .env, add your keys, then restart the backend.
PORT=3000

# Required to enable VirusTotal URL reports and submissions.
VIRUSTOTAL_API_KEY=

# Required to enable Google Safe Browsing v4 URL checks.
GOOGLE_SAFE_BROWSING_API_KEY=

# Optional URLhaus lookups require an abuse.ch Auth-Key. Enable only when set.
URLHAUS_ENABLED=false
URLHAUS_API_KEY=
